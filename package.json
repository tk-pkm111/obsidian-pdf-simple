{
	"name": "obsidian-pdf-simple",
	"version": "0.0.7",
	"description": "Obsidian plugin: highlight PDFs in the built-in viewer and collect the highlighted text in a paired note.",
	"license": "MIT",
	"private": true,
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"typecheck": "tsc -noEmit",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"*.{mjs,mts,ts}\"",
		"format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"*.{mjs,mts,ts}\"",
		"test": "vitest run",
		"test:watch": "vitest",
		"check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"vault:setup": "bash scripts/setup-dev-vault.sh",
		"vault:open": "open \"obsidian://open?vault=dev-vault\"",
		"e2e": "node scripts/e2e-obsidian.mjs",
		"references:fetch": "bash scripts/fetch-references.sh"
	},
	"keywords": [],
	"devDependencies": {
		"@codemirror/state": "6.5.0",
		"@codemirror/view": "6.38.6",
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "^0.28.2",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"moment": "2.29.4",
		"obsidian": "latest",
		"prettier": "^3.9.9",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1",
		"vitest": "^5.0.3",
		"yaml": "^2.9.1"
	}
}
