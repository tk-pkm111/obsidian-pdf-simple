# エディタ
.vscode
*.iml
.idea

# npm
node_modules

# ビルド成果物（リリース時に GitHub Release へ添付する。リポジトリには入れない）
main.js
*.map

# Obsidian のプラグイン設定ファイル
data.json

# macOS
.DS_Store

# テスト
coverage

# 開発用 Vault: 作業状態とプラグイン本体（ビルド／スクリプトで再生成できる）
dev-vault/.obsidian/workspace*.json
dev-vault/.obsidian/plugins/

# 開発用 Vault で試したノート・PDF・画像は入れない（個人の PDF やその抜き書きが入らないように）。
# リポジトリに入れるのは README と設定、自作のテスト用 PDF（dev-vault/PDF/sample-*.pdf）だけ
dev-vault/*
!dev-vault/README.md
!dev-vault/.obsidian/
!dev-vault/PDF/
dev-vault/PDF/*
!dev-vault/PDF/sample-*.pdf

# 参照用に取得した外部リポジトリ（npm run references:fetch で再取得できる）
references/

# プロモーション動画の書き出し（MP4・コマ）
promo/out/
